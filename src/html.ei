fun escapeHtml(str: String): String {
    var result = str
    result = result.replace("&", "&amp;")
    result = result.replace("<", "&lt;")
    result = result.replace(">", "&gt;")
    result = result.replace("\"", "&quot;")
    result = result.replace("'", "&#39;")
    return result
}

// Renders arbitrary extra attributes (Alpine.js `x-*`/`@*`/`:*`, htmx,
// ARIA, ...) as ` key="escaped-value"` pairs. Empty map renders nothing.
fun renderAttrs(attrs: Map<String, String>): String {
    var out = ""
    var i = 0
    while (i < attrs.entries.size()) {
        var curr = attrs.entries.get(i)
        while (curr != null) {
            out = "$out ${curr!!.key}=\"${escapeHtml(curr!!.value)}\""
            curr = curr!!.next
        }
        i = i + 1
    }
    return out
}

type HTMLBuilder(var content: String = "") {

    fun head(init: HeadBuilder.() -> Void) {
        val builder = HeadBuilder()
        init(builder)
        content = "$content<head>${builder.content}</head>"
    }

    fun body(class: String = "", id: String = "", init: BodyBuilder.() -> Void) {
        val builder = BodyBuilder()
        init(builder)
        var attrs = ""
        if (class != "") {
            attrs = "$attrs class=\"${escapeHtml(class)}\""
        }
        if (id != "") {
            attrs = "$attrs id=\"${escapeHtml(id)}\""
        }
        content = "$content<body$attrs>${builder.content}</body>"
    }
}

type HeadBuilder(var content: String = "") {

    fun title(text: String) {
        content = "$content<title>${escapeHtml(text)}</title>"
    }

    fun meta(name: String = "", contentValue: String = "", charset: String = "", httpEquiv: String = "") {
        var attrs = ""
        if (name != "") {
            attrs = "$attrs name=\"${escapeHtml(name)}\""
        }
        if (contentValue != "") {
            attrs = "$attrs content=\"${escapeHtml(contentValue)}\""
        }
        if (charset != "") {
            attrs = "$attrs charset=\"${escapeHtml(charset)}\""
        }
        if (httpEquiv != "") {
            attrs = "$attrs http-equiv=\"${escapeHtml(httpEquiv)}\""
        }
        content = "$content<meta$attrs />"
    }

    fun link(rel: String = "", href: String = "", linkType: String = "", sizes: String = "") {
        var attrs = ""
        if (rel != "") {
            attrs = "$attrs rel=\"${escapeHtml(rel)}\""
        }
        if (href != "") {
            attrs = "$attrs href=\"${escapeHtml(href)}\""
        }
        if (linkType != "") {
            attrs = "$attrs type=\"${escapeHtml(linkType)}\""
        }
        if (sizes != "") {
            attrs = "$attrs sizes=\"${escapeHtml(sizes)}\""
        }
        content = "$content<link$attrs />"
    }

    fun script(src: String = "", scriptType: String = "") {
        var attrs = ""
        if (src != "") {
            attrs = "$attrs src=\"${escapeHtml(src)}\""
        }
        if (scriptType != "") {
            attrs = "$attrs type=\"${escapeHtml(scriptType)}\""
        }
        content = "$content<script$attrs></script>"
    }

    // Inline <script> with raw JS code (e.g. tailwind.config). The code is
    // emitted verbatim — never interpolate untrusted data here.
    fun scriptCode(code: String) {
        content = "$content<script>$code</script>"
    }

    fun style(css: String = "") {
        content = "$content<style>$css</style>"
    }
}

type SvgBuilder(var content: String = "") {

    fun g(fill: String = "", stroke: String = "", strokeWidth: String = "", strokeLinecap: String = "", init: SvgBuilder.() -> Void) {
        val builder = SvgBuilder()
        init(builder)
        var attrs = ""
        if (fill != "") { attrs = "$attrs fill=\"${escapeHtml(fill)}\"" }
        if (stroke != "") { attrs = "$attrs stroke=\"${escapeHtml(stroke)}\"" }
        if (strokeWidth != "") { attrs = "$attrs stroke-width=\"${escapeHtml(strokeWidth)}\"" }
        if (strokeLinecap != "") { attrs = "$attrs stroke-linecap=\"${escapeHtml(strokeLinecap)}\"" }
        content = "$content<g$attrs>${builder.content}</g>"
    }

    fun path(d: String = "", fill: String = "", opacity: String = "") {
        var attrs = ""
        if (d != "") { attrs = "$attrs d=\"${escapeHtml(d)}\"" }
        if (fill != "") { attrs = "$attrs fill=\"${escapeHtml(fill)}\"" }
        if (opacity != "") { attrs = "$attrs opacity=\"${escapeHtml(opacity)}\"" }
        content = "$content<path$attrs />"
    }
}

type BodyBuilder(var content: String = "") {

    fun renderTagSimple(tag: String, text: String, class: String, id: String, attrs: Map<String, String> = Map()) {
        var attrStr = ""
        if (class != "") {
            attrStr = "$attrStr class=\"${escapeHtml(class)}\""
        }
        if (id != "") {
            attrStr = "$attrStr id=\"${escapeHtml(id)}\""
        }
        attrStr = "$attrStr${renderAttrs(attrs)}"
        content = "$content<$tag$attrStr>${escapeHtml(text)}</$tag>"
    }

    fun renderTagHtmx(tag: String, class: String, id: String, hxGet: String = "", hxTarget: String = "", hxSwap: String = "", hxTrigger: String = "", init: BodyBuilder.() -> Void, hxPost: String = "", attrs: Map<String, String> = Map()) {
        val builder = BodyBuilder()
        init(builder)
        var attrStr = ""
        if (class != "") {
            attrStr = "$attrStr class=\"${escapeHtml(class)}\""
        }
        if (id != "") {
            attrStr = "$attrStr id=\"${escapeHtml(id)}\""
        }
        if (hxGet != "") {
            attrStr = "$attrStr hx-get=\"${escapeHtml(hxGet)}\""
        }
        if (hxPost != "") {
            attrStr = "$attrStr hx-post=\"${escapeHtml(hxPost)}\""
        }
        if (hxTarget != "") {
            attrStr = "$attrStr hx-target=\"${escapeHtml(hxTarget)}\""
        }
        if (hxSwap != "") {
            attrStr = "$attrStr hx-swap=\"${escapeHtml(hxSwap)}\""
        }
        if (hxTrigger != "") {
            attrStr = "$attrStr hx-trigger=\"${escapeHtml(hxTrigger)}\""
        }
        attrStr = "$attrStr${renderAttrs(attrs)}"
        content = "$content<$tag$attrStr>${builder.content}</$tag>"
    }

    fun renderTag(tag: String, class: String, id: String, init: BodyBuilder.() -> Void, attrs: Map<String, String> = Map()) {
        renderTagHtmx(tag = tag, class = class, id = id, init = init, attrs = attrs)
    }

    // Escape hatch for any tag not covered above, with arbitrary attributes.
    fun tag(name: String, init: BodyBuilder.() -> Void, attrs: Map<String, String> = Map()) {
        val builder = BodyBuilder()
        init(builder)
        content = "$content<$name${renderAttrs(attrs)}>${builder.content}</$name>"
    }

    fun form(class: String = "", id: String = "", hxPost: String = "", hxTarget: String = "", hxSwap: String = "", init: BodyBuilder.() -> Void, attrs: Map<String, String> = Map<String, String>()) {
        renderTagHtmx(tag = "form", class = class, id = id, hxPost = hxPost, hxTarget = hxTarget, hxSwap = hxSwap, init = init, attrs = attrs)
    }

    fun label(text: String = "", class: String = "", id: String = "", htmlFor: String = "", attrs: Map<String, String> = Map<String, String>()) {
        var attrStr = ""
        if (class != "") {
            attrStr = "$attrStr class=\"${escapeHtml(class)}\""
        }
        if (id != "") {
            attrStr = "$attrStr id=\"${escapeHtml(id)}\""
        }
        if (htmlFor != "") {
            attrStr = "$attrStr for=\"${escapeHtml(htmlFor)}\""
        }
        attrStr = "$attrStr${renderAttrs(attrs)}"
        content = "$content<label$attrStr>${escapeHtml(text)}</label>"
    }

    fun label(class: String = "", id: String = "", htmlFor: String = "", init: BodyBuilder.() -> Void, attrs: Map<String, String> = Map<String, String>()) {
        val builder = BodyBuilder()
        init(builder)
        var attrStr = ""
        if (class != "") {
            attrStr = "$attrStr class=\"${escapeHtml(class)}\""
        }
        if (id != "") {
            attrStr = "$attrStr id=\"${escapeHtml(id)}\""
        }
        if (htmlFor != "") {
            attrStr = "$attrStr for=\"${escapeHtml(htmlFor)}\""
        }
        attrStr = "$attrStr${renderAttrs(attrs)}"
        content = "$content<label$attrStr>${builder.content}</label>"
    }

    fun write(text: String) {
        content = content + escapeHtml(text)
    }

    fun raw(insecure: String) {
        content = content + insecure
    }

    fun h1(text: String = "", class: String = "", id: String = "") {
        renderTagSimple("h1", text, class, id)
    }

    fun h1(class: String = "", id: String = "", init: BodyBuilder.() -> Void) {
        renderTag("h1", class, id, init)
    }

    fun h2(text: String = "", class: String = "", id: String = "") {
        renderTagSimple("h2", text, class, id)
    }

    fun h2(class: String = "", id: String = "", init: BodyBuilder.() -> Void) {
        renderTag("h2", class, id, init)
    }

    fun h3(text: String = "", class: String = "", id: String = "") {
        renderTagSimple("h3", text, class, id)
    }

    fun h3(class: String = "", id: String = "", init: BodyBuilder.() -> Void) {
        renderTag("h3", class, id, init)
    }

    fun p(text: String = "", class: String = "", id: String = "") {
        renderTagSimple("p", text, class, id)
    }

    fun p(class: String = "", id: String = "", init: BodyBuilder.() -> Void) {
        renderTag("p", class, id, init)
    }

    fun div(class: String = "", id: String = "", hxGet: String = "", hxTarget: String = "", hxSwap: String = "", hxTrigger: String = "", dataHint: String = "", dataOutput: String = "", attrs: Map<String, String> = Map(), init: BodyBuilder.() -> Void) {
        val builder = BodyBuilder()
        init(builder)
        var attrStr = ""
        if (class != "") {
            attrStr = "$attrStr class=\"${escapeHtml(class)}\""
        }
        if (id != "") {
            attrStr = "$attrStr id=\"${escapeHtml(id)}\""
        }
        if (hxGet != "") {
            attrStr = "$attrStr hx-get=\"${escapeHtml(hxGet)}\""
        }
        if (hxTarget != "") {
            attrStr = "$attrStr hx-target=\"${escapeHtml(hxTarget)}\""
        }
        if (hxSwap != "") {
            attrStr = "$attrStr hx-swap=\"${escapeHtml(hxSwap)}\""
        }
        if (hxTrigger != "") {
            attrStr = "$attrStr hx-trigger=\"${escapeHtml(hxTrigger)}\""
        }
        if (dataHint != "") {
            attrStr = "$attrStr data-hint=\"${escapeHtml(dataHint)}\""
        }
        if (dataOutput != "") {
            attrStr = "$attrStr data-output=\"${escapeHtml(dataOutput)}\""
        }
        attrStr = "$attrStr${renderAttrs(attrs)}"
        content = "$content<div$attrStr>${builder.content}</div>"
    }

    fun header(class: String = "", id: String = "", init: BodyBuilder.() -> Void) {
        renderTag("header", class, id, init)
    }

    fun nav(class: String = "", id: String = "", init: BodyBuilder.() -> Void) {
        renderTag("nav", class, id, init)
    }

    fun ul(class: String = "", id: String = "", init: BodyBuilder.() -> Void) {
        renderTag("ul", class, id, init)
    }

    fun li(class: String = "", id: String = "", init: BodyBuilder.() -> Void) {
        renderTag("li", class, id, init)
    }

    fun main(class: String = "", id: String = "", init: BodyBuilder.() -> Void) {
        renderTag("main", class, id, init)
    }

    fun footer(class: String = "", id: String = "", hxGet: String = "", hxTarget: String = "", hxSwap: String = "", hxTrigger: String = "", dataHint: String = "", dataOutput: String = "", init: BodyBuilder.() -> Void) {
        renderTagHtmx("footer", class, id, hxGet, hxTarget, hxSwap, hxTrigger, init)
    }

    fun section(class: String = "", id: String = "", hxGet: String = "", hxTarget: String = "", hxSwap: String = "", hxTrigger: String = "", dataHint: String = "", dataOutput: String = "", init: BodyBuilder.() -> Void) {
        renderTagHtmx("section", class, id, hxGet, hxTarget, hxSwap, hxTrigger, init)
    }

    fun b(text: String = "", class: String = "", id: String = "") {
        renderTagSimple("b", text, class, id)
    }

    fun b(class: String = "", id: String = "", init: BodyBuilder.() -> Void) {
        renderTag("b", class, id, init)
    }

    fun strong(text: String = "", class: String = "", id: String = "") {
        renderTagSimple("strong", text, class, id)
    }

    fun strong(class: String = "", id: String = "", init: BodyBuilder.() -> Void) {
        renderTag("strong", class, id, init)
    }

    fun small(text: String = "", class: String = "", id: String = "") {
        renderTagSimple("small", text, class, id)
    }

    fun small(class: String = "", id: String = "", init: BodyBuilder.() -> Void) {
        renderTag("small", class, id, init)
    }

    fun i(text: String = "", class: String = "", id: String = "") {
        renderTagSimple("i", text, class, id)
    }

    fun i(class: String = "", id: String = "", init: BodyBuilder.() -> Void) {
        renderTag("i", class, id, init)
    }

    fun span(class: String = "", id: String = "", init: BodyBuilder.() -> Void) {
        renderTag("span", class, id, init)
    }

    fun span(class: String = "", id: String = "", text: String = "") {
        renderTagSimple("span", text, class, id)
    }

    fun a(href: String = "", class: String = "", id: String = "", target: String = "", rel: String = "", init: BodyBuilder.() -> Void, attrs: Map<String, String> = Map<String, String>()) {
        val builder = BodyBuilder()
        init(builder)
        var attrStr = ""
        if (href != "") {
            attrStr = "$attrStr href=\"${escapeHtml(href)}\""
        }
        if (class != "") {
            attrStr = "$attrStr class=\"${escapeHtml(class)}\""
        }
        if (id != "") {
            attrStr = "$attrStr id=\"${escapeHtml(id)}\""
        }
        if (target != "") {
            attrStr = "$attrStr target=\"${escapeHtml(target)}\""
        }
        if (rel != "") {
            attrStr = "$attrStr rel=\"${escapeHtml(rel)}\""
        }
        attrStr = "$attrStr${renderAttrs(attrs)}"
        content = "$content<a$attrStr>${builder.content}</a>"
    }

    fun a(href: String = "", class: String = "", id: String = "", text: String = "", target: String = "", rel: String = "") {
        var attrs = ""
        if (href != "") {
            attrs = "$attrs href=\"${escapeHtml(href)}\""
        }
        if (class != "") {
            attrs = "$attrs class=\"${escapeHtml(class)}\""
        }
        if (id != "") {
            attrs = "$attrs id=\"${escapeHtml(id)}\""
        }
        if (target != "") {
            attrs = "$attrs target=\"${escapeHtml(target)}\""
        }
        if (rel != "") {
            attrs = "$attrs rel=\"${escapeHtml(rel)}\""
        }
        content = "$content<a$attrs>${escapeHtml(text)}</a>"
    }

    fun buttonAttrs(btnType: String, class: String, id: String, hxGet: String, hxTarget: String, hxSwap: String, hxPost: String, attrs: Map<String, String>): String {
        var attrStr = ""
        if (btnType != "") {
            attrStr = "$attrStr type=\"${escapeHtml(btnType)}\""
        }
        if (class != "") {
            attrStr = "$attrStr class=\"${escapeHtml(class)}\""
        }
        if (id != "") {
            attrStr = "$attrStr id=\"${escapeHtml(id)}\""
        }
        if (hxGet != "") {
            attrStr = "$attrStr hx-get=\"${escapeHtml(hxGet)}\""
        }
        if (hxPost != "") {
            attrStr = "$attrStr hx-post=\"${escapeHtml(hxPost)}\""
        }
        if (hxTarget != "") {
            attrStr = "$attrStr hx-target=\"${escapeHtml(hxTarget)}\""
        }
        if (hxSwap != "") {
            attrStr = "$attrStr hx-swap=\"${escapeHtml(hxSwap)}\""
        }
        return "$attrStr${renderAttrs(attrs)}"
    }

    fun button(btnType: String = "button", class: String = "", id: String = "", hxGet: String = "", hxTarget: String = "", hxSwap: String = "", hxPost: String = "", attrs: Map<String, String> = Map(), init: BodyBuilder.() -> Void) {
        val builder = BodyBuilder()
        init(builder)
        val attrStr = buttonAttrs(btnType, class, id, hxGet, hxTarget, hxSwap, hxPost, attrs)
        content = "$content<button$attrStr>${builder.content}</button>"
    }

    fun button(btnType: String = "button", class: String = "", id: String = "", hxGet: String = "", hxTarget: String = "", hxSwap: String = "", text: String = "", hxPost: String = "", attrs: Map<String, String> = Map()) {
        val attrStr = buttonAttrs(btnType, class, id, hxGet, hxTarget, hxSwap, hxPost, attrs)
        content = "$content<button$attrStr>${escapeHtml(text)}</button>"
    }

    fun img(src: String = "", alt: String = "", class: String = "", id: String = "", attrs: Map<String, String> = Map<String, String>()) {
        var attrStr = ""
        if (src != "") {
            attrStr = "$attrStr src=\"${escapeHtml(src)}\""
        }
        if (alt != "") {
            attrStr = "$attrStr alt=\"${escapeHtml(alt)}\""
        }
        if (class != "") {
            attrStr = "$attrStr class=\"${escapeHtml(class)}\""
        }
        if (id != "") {
            attrStr = "$attrStr id=\"${escapeHtml(id)}\""
        }
        attrStr = "$attrStr${renderAttrs(attrs)}"
        content = "$content<img$attrStr />"
    }

    fun br() {
        content = "$content<br />"
    }

    fun hr(class: String = "") {
        var attrs = ""
        if (class != "") {
            attrs = "$attrs class=\"${escapeHtml(class)}\""
        }
        content = "$content<hr$attrs />"
    }

    // Injects untouched HTML (not escaped). Use for raw snippets only.
    fun raw(rawContent: String) {
        content = content + rawContent
    }

    fun pre(text: String = "", class: String = "", id: String = "") {
        renderTagSimple("pre", text, class, id)
    }

    fun pre(class: String = "", id: String = "", init: BodyBuilder.() -> Void) {
        renderTag("pre", class, id, init)
    }

    fun code(text: String = "", class: String = "", id: String = "") {
        renderTagSimple("code", text, class, id)
    }

    fun code(class: String = "", id: String = "", init: BodyBuilder.() -> Void) {
        renderTag("code", class, id, init)
    }

    fun svg(viewBox: String = "", class: String = "", preserveAspectRatio: String = "", id: String = "", init: SvgBuilder.() -> Void) {
        val builder = SvgBuilder()
        init(builder)
        var attrs = ""
        if (viewBox != "") {
            attrs = "$attrs viewBox=\"${escapeHtml(viewBox)}\""
        }
        if (class != "") {
            attrs = "$attrs class=\"${escapeHtml(class)}\""
        }
        if (preserveAspectRatio != "") {
            attrs = "$attrs preserveAspectRatio=\"${escapeHtml(preserveAspectRatio)}\""
        }
        if (id != "") {
            attrs = "$attrs id=\"${escapeHtml(id)}\""
        }
        content = "$content<svg$attrs>${builder.content}</svg>"
    }

    fun select(class: String = "", id: String = "", name: String = "", init: BodyBuilder.() -> Void) {
        val builder = BodyBuilder()
        init(builder)
        var attrs = ""
        if (class != "") {
            attrs = "$attrs class=\"${escapeHtml(class)}\""
        }
        if (id != "") {
            attrs = "$attrs id=\"${escapeHtml(id)}\""
        }
        if (name != "") {
            attrs = "$attrs name=\"${escapeHtml(name)}\""
        }
        content = "$content<select$attrs>${builder.content}</select>"
    }

    fun option(text: String = "", value: String = "", class: String = "", id: String = "") {
        var attrs = ""
        if (value != "") {
            attrs = "$attrs value=\"${escapeHtml(value)}\""
        }
        if (class != "") {
            attrs = "$attrs class=\"${escapeHtml(class)}\""
        }
        if (id != "") {
            attrs = "$attrs id=\"${escapeHtml(id)}\""
        }
        content = "$content<option$attrs>${escapeHtml(text)}</option>"
    }

    fun input(inputType: String = "text", class: String = "", id: String = "", placeholder: String = "", value: String = "", name: String = "", attrs: Map<String, String> = Map()) {
        var attrStr = ""
        if (inputType != "") {
            attrStr = "$attrStr type=\"${escapeHtml(inputType)}\""
        }
        if (class != "") {
            attrStr = "$attrStr class=\"${escapeHtml(class)}\""
        }
        if (id != "") {
            attrStr = "$attrStr id=\"${escapeHtml(id)}\""
        }
        if (placeholder != "") {
            attrStr = "$attrStr placeholder=\"${escapeHtml(placeholder)}\""
        }
        if (value != "") {
            attrStr = "$attrStr value=\"${escapeHtml(value)}\""
        }
        if (name != "") {
            attrStr = "$attrStr name=\"${escapeHtml(name)}\""
        }
        attrStr = "$attrStr${renderAttrs(attrs)}"
        content = "$content<input$attrStr />"
    }

    fun textarea(class: String = "", id: String = "", name: String = "", placeholder: String = "", text: String = "") {
        renderTagSimple("textarea", text, class, id, attrs = ["placeholder" of placeholder, "name" of name])
    }

    fun textarea(class: String = "", id: String = "", name: String = "", placeholder: String = "", init: BodyBuilder.() -> Void) {
        renderTag("textarea", class, id, init, attrs = ["placeholder" of placeholder, "name" of name])
    }

    fun script(code: String = "", src: String = "", scriptType: String = "") {
        if (src != "") {
            val st = if (scriptType != "") scriptType else "module"
            val attrs = " src=\"${escapeHtml(src)}\" type=\"${escapeHtml(st)}\""
            content = "$content<script$attrs></script>"
        } else {
            content = "$content<script>$code</script>"
        }
    }

    // fun script(code: () -> String) {
    //     content = content + "<script>" + code() + "</script>"
    // }
}

fun html(init: HTMLBuilder.() -> Void): String {
    val builder = HTMLBuilder()
    init(builder)
    return "<!DOCTYPE html><html>${builder.content}</html>"
}

fun fragment(init: BodyBuilder.() -> Void): String {
    val builder = BodyBuilder()
    init(builder)
    return builder.content
}
